-- Create (Criar)          → Comando INSERT
-- Read (Ler/Consultar)    → Comando SELECT
-- Update (Atualizar/Mudar) → Comando UPDATE
-- Delete (Excluir/Apagar) → Comando DELETE

create database burguer_tay
default character SET utf8mb4
collate utf8mb4_0900_ai_ci;
use burguer_tay;

create table if not exists cardapio (
    id int auto_increment primary key,
    nome varchar(50),
    categoria varchar(30),
    preco decimal(10,2),
    disponivel_estoque int
) default charset = utf8mb4;

insert into cardapio (nome, categoria, preco, disponivel_estoque) values
('X-Burger Clássico', 'Hambúrgueres', 22.00, 50),
('Batata Frita G', 'Acompanhamentos', 12.00, 40),
('Combo Supremo', 'Combos', 45.00, 15),
('Suco de Laranja 400ml', 'Bebidas', 8.00, 30),
('Milkshake Ovomaltine', 'Sobremesas', 15.00, 20);

UPDATE nome_tabela
SET coluna = nome_valor
WHERE condição;



